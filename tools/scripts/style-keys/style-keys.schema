PADDING
BORDER
FLEX_GROW
FLEX_SHRINK
FLEX_BASIS
SIZE
MIN_SIZE
MAX_SIZE
GAP
ASPECT_RATIO
GRID_AUTO_FLOW
GRID_COLUMN
GRID_ROW
SCROLLBAR_WIDTH
ALIGN
BOX_SIZING
OVERFLOW
ITEM_IS_TABLE
ITEM_IS_REPLACED
DISPLAY_MODE
FORCE_INLINE
MIN_CONTENT_WIDTH
MIN_CONTENT_HEIGHT
MAX_CONTENT_WIDTH
MAX_CONTENT_HEIGHT
BORDER_STYLE
BORDER_RADIUS
BORDER_COLOR
FLOAT
CLEAR
OBJECT_FIT
Z_INDEX
LIST_STYLE_POSITION
LIST_STYLE_TYPE
INVALIDATE_TEXT                      kotlin=-     # Kotlin's INVALIDATE_TEXT is every bit
FONT_COLOR                           swift=color
DECORATION_LINE
DECORATION_COLOR
TEXT_ALIGN
