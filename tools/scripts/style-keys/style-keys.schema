ALIGN_SELF
ALIGN_CONTENT
JUSTIFY_ITEMS
JUSTIFY_SELF
JUSTIFY_CONTENT
INSET
MARGIN
PADDING
BORDER
FLEX_GROW
FLEX_SHRINK
FLEX_BASIS
SIZE
MIN_SIZE
MAX_SIZE
GAP
ASPECT_RATIO
GRID_AUTO_FLOW
GRID_COLUMN
GRID_ROW
SCROLLBAR_WIDTH
ALIGN
BOX_SIZING
OVERFLOW
ITEM_IS_TABLE
ITEM_IS_REPLACED
DISPLAY_MODE
FORCE_INLINE
MIN_CONTENT_WIDTH
MIN_CONTENT_HEIGHT
MAX_CONTENT_WIDTH
MAX_CONTENT_HEIGHT
BORDER_STYLE
BORDER_RADIUS
BORDER_COLOR
FLOAT
CLEAR
OBJECT_FIT
Z_INDEX
LIST_STYLE_POSITION
LIST_STYLE_TYPE
INVALIDATE_TEXT                      kotlin=-     # Kotlin's INVALIDATE_TEXT is every bit
FONT_COLOR                           swift=color
DECORATION_LINE
DECORATION_COLOR
TEXT_ALIGN
TEXT_JUSTIFY
BACKGROUND_COLOR
FONT_SIZE
TEXT_TRANSFORM
FONT_STYLE
FONT_STYLE_SLANT
TEXT_WRAP
TEXT_OVERFLOW
DECORATION_STYLE
WHITE_SPACE
FONT_WEIGHT
LINE_HEIGHT
VERTICAL_ALIGN
DECORATION_THICKNESS                 swift=decorationThinkness
TEXT_SHADOWS                         swift=textShadow
FONT_FAMILY
LETTER_SPACING
FONT_VARIANT_NUMERIC
OBJECT_POSITION
WRITING_MODE
UNICODE_BIDI
HYPHENS
CARET_COLOR
WORD_SPACING
FONT_STRETCH
TEXT_INDENT
LINE_CLAMP
TRANSFORM_ORIGIN
TEXT_ORIENTATION
TEXT_COMBINE_UPRIGHT
TEXT_SPACING_TRIM
VISIBILITY
FONT_FEATURE_SETTINGS

[state_groups]
# Text shaping keys can change intrinsic size. Visual text keys only rebuild paint.
TEXT_LAYOUT kotlin,swift FONT_SIZE FONT_WEIGHT FONT_STYLE FONT_STYLE_SLANT FONT_FAMILY FONT_VARIANT_NUMERIC FONT_FEATURE_SETTINGS TEXT_WRAP WHITE_SPACE TEXT_TRANSFORM LETTER_SPACING TEXT_JUSTIFY LINE_HEIGHT TEXT_ALIGN TEXT_OVERFLOW WORD_SPACING WRITING_MODE UNICODE_BIDI HYPHENS FONT_STRETCH TEXT_INDENT LINE_CLAMP TEXT_ORIENTATION TEXT_COMBINE_UPRIGHT TEXT_SPACING_TRIM LIST_STYLE_POSITION LIST_STYLE_TYPE VERTICAL_ALIGN INVALIDATE_TEXT
TEXT_VISUAL kotlin,swift FONT_COLOR DECORATION_LINE DECORATION_COLOR DECORATION_STYLE DECORATION_THICKNESS BACKGROUND_COLOR TEXT_SHADOWS
ALL_TEXT kotlin,swift @TEXT_LAYOUT @TEXT_VISUAL
LAYOUT_MASK kotlin DISPLAY..MAX_CONTENT_HEIGHT FLOAT CLEAR VISIBILITY @TEXT_LAYOUT
BORDER_PAINT kotlin,swift BORDER BORDER_STYLE BORDER_RADIUS BORDER_COLOR
OBJECT_PAINT kotlin,swift OBJECT_FIT OBJECT_POSITION
PAINT_ONLY swift @TEXT_VISUAL BORDER_STYLE BORDER_RADIUS BORDER_COLOR @OBJECT_PAINT Z_INDEX CARET_COLOR TRANSFORM_ORIGIN
# WinUI refreshes TextBlocks and native input controls through separate paths.
WINDOWS_LAYOUT cpp DISPLAY..MAX_CONTENT_HEIGHT FLOAT..CLEAR LIST_STYLE_POSITION..INVALIDATE_TEXT TEXT_ALIGN..TEXT_JUSTIFY FONT_SIZE..TEXT_OVERFLOW WHITE_SPACE..VERTICAL_ALIGN FONT_FAMILY..FONT_VARIANT_NUMERIC WRITING_MODE..HYPHENS WORD_SPACING..FONT_STRETCH TEXT_INDENT..LINE_CLAMP TEXT_ORIENTATION VISIBILITY
WINDOWS_TEXT_CHANGES ts INVALIDATE_TEXT..TEXT_JUSTIFY FONT_SIZE..FONT_VARIANT_NUMERIC WRITING_MODE..HYPHENS WORD_SPACING..FONT_STRETCH TEXT_INDENT..LINE_CLAMP TEXT_ORIENTATION
WINDOWS_TEXT cpp DIRECTION @WINDOWS_TEXT_CHANGES
WINDOWS_CONTROLS cpp INVALIDATE_TEXT..FONT_VARIANT_NUMERIC WRITING_MODE..HYPHENS WORD_SPACING..FONT_STRETCH
WINDOWS_PAINT cpp BACKGROUND_COLOR BORDER BORDER_STYLE BORDER_RADIUS BORDER_COLOR OVERFLOW OVERFLOW_X OVERFLOW_Y Z_INDEX
WINDOWS_DISPLAY cpp DISPLAY DISPLAY_MODE
FLOW_TYPE ts DISPLAY DISPLAY_MODE POSITION FLOAT
LIST_MARKER cpp LIST_STYLE_POSITION LIST_STYLE_TYPE

[records]
# Rust-owned lists. Record kinds specify an ABI ID, a revision field in the
# fixed style buffer, and the layout of one element in their flat array.
# Append new IDs and preserve the order of existing record fields.
BOX_SHADOW      0 BOX_SHADOW_REVISION      SHADOW
TEXT_SHADOW     1 TEXT_SHADOW_REVISION     SHADOW
FILTER          2 FILTER_REVISION          FILTER
BACKDROP_FILTER  3 BACKDROP_FILTER_REVISION  FILTER
FONT_FEATURES    4 FONT_FEATURES_REVISION     FONT_FEATURE

[record_layouts]
SHADOW X Y BLUR SPREAD COLOR INSET
FILTER KIND AMOUNT_OR_X Y BLUR COLOR
FONT_FEATURE TAG VALUE
BACKGROUND IMAGE_KIND COLOR REPEAT_X REPEAT_Y ORIGIN CLIP ATTACHMENT SIZE_KIND POSITION_X_FRACTION POSITION_X_PIXELS POSITION_Y_FRACTION POSITION_Y_PIXELS WIDTH_FRACTION WIDTH_PIXELS HEIGHT_FRACTION HEIGHT_PIXELS BLEND
BACKGROUND_OFFSETS POSITION_X POSITION_Y WIDTH HEIGHT
BACKGROUND_INPUT COLOR IMAGE REPEAT POSITION SIZE CLIP ORIGIN ATTACHMENT
BORDER_COMPONENTS TOP RIGHT BOTTOM LEFT STYLE COLOR
BORDER_SIDE_COMPONENTS WIDTH STYLE COLOR
BORDER_RADII HORIZONTAL_TOP_LEFT HORIZONTAL_TOP_RIGHT HORIZONTAL_BOTTOM_RIGHT HORIZONTAL_BOTTOM_LEFT VERTICAL_TOP_LEFT VERTICAL_TOP_RIGHT VERTICAL_BOTTOM_RIGHT VERTICAL_BOTTOM_LEFT
CLIP_PATH KIND BOX EVEN_ODD RADIUS_X_KIND RADIUS_Y_KIND HAS_POSITION HAS_MATH
SVG_PATH KIND VERTEX_END X1 Y1 X2 Y2 X Y
MASK_LAYER CLIP MODE COMPOSITE
MASK_INPUT IMAGE SIZE POSITION REPEAT ORIGIN CLIP MODE COMPOSITE
NINE_SLICE_INPUT SOURCE SLICE WIDTH OUTSET REPEAT MODE
NINE_SLICE FILL REPEAT_X REPEAT_Y LUMINANCE
NINE_SLICE_SIDE KIND VALUE HAS_MATH
TEXT_DECORATION LINE STYLE COLOR THICKNESS
CSS_LENGTH_RESULT KIND VALUE
CSS_POSITION_RESULT X_TYPE X_VALUE Y_TYPE Y_VALUE
CSS_DECLARATION_HEADER NAME VALUE FIELD_COUNT
CSS_INLINE_REPLAY VIEWPORT_DEPENDENT FONT_DEPENDENT FONT_SIZE
CSS_BACKGROUND_WRITE PROPERTY VALUE CURRENT_COLOR
CSS_BACKGROUND_RESULT LAYERS_CHANGED IMAGES_REPLACED IMAGE_DECLARATION SHORTHAND_VALUE COLOR COLOR_FROM_SHORTHAND LAST_IMAGE_FROM_SHORTHAND SHORTHAND_RESET
CSS_EFFECT_WRITE PROPERTY VALUE CURRENT_COLOR
CSS_EFFECT_RESULT VALUE RECORDS
CSS_MASK_WRITE SLOT VALUE
CSS_BORDER_RESULT TOP_KIND TOP_VALUE RIGHT_KIND RIGHT_VALUE BOTTOM_KIND BOTTOM_VALUE LEFT_KIND LEFT_VALUE STYLE COLOR
CSS_BORDER_SIDE_RESULT KIND VALUE STYLE COLOR
GRADIENT_INTERPOLATION DIRECTION SPACE HUE
ANDROID_PAINT_READ VALUES IMAGES OFFSETS GRADIENTS GRADIENT_INFO SNAPSHOT
ANDROID_GRADIENT_INFO KIND REPEATING STOP_COUNT DIRECTION SPACE HUE
SVG_FONT_PREFIX ITALIC WEIGHT SIZE
SVG_CSS_DECLARATION NAME VALUE IMPORTANT
SVG_CSS_SELECTOR TYPE ID_COUNT CLASS_COUNT
SVG_CSS_RULE SELECTOR_COUNT DECLARATION_COUNT
SVG_PAINT KIND VALUE
CSS_ANIMATION_LAYER COMPONENT_COUNT
CSS_ANIMATION_COMPONENT KIND VALUE UNIT
SVG_LENGTH_COMPONENTS LENGTH PERCENT
SVG_AFFINE A B C D X Y
SVG_ASPECT_RATIO ALIGN_X ALIGN_Y UNIFORM SLICE

[css_parse_kinds]
SHADOWS 0
FILTERS 1
LENGTH 2
FONT_SIZE 3
CLAMP_LENGTH 4
TRANSFORM_ORIGIN 5
OBJECT_POSITION 6
LINE_HEIGHT 7
LETTER_SPACING 8
TEXT_INDENT 9
WORD_SPACING 10
VERTICAL_ALIGN 11
DIMENSION 12
LENGTH_AUTO 13
BORDER_RADIUS 14
BORDER_CORNER_RADIUS 15
SVG_NUMBER_LIST 16
SVG_TRANSFORM 17
SVG_LENGTH 18
SVG_LENGTH_LIST 19
SVG_OPACITY 20
SVG_ANGLE 21
SVG_ASPECT_RATIO 22
SVG_NUMBER 23
SVG_DASH_ARRAY 24

[grid_properties]
GRID_AUTO_ROWS 0 tracks
GRID_AUTO_COLUMNS 1 tracks
GRID_COLUMN 2
GRID_COLUMN_START 3
GRID_COLUMN_END 4
GRID_ROW 5
GRID_ROW_START 6
GRID_ROW_END 7
GRID_TEMPLATE_ROWS 8 tracks
GRID_TEMPLATE_COLUMNS 9 tracks
GRID_AREA 10
GRID_TEMPLATE_AREAS 11

[css_math_properties]
# Additional stylesheet declarations that accept CSS math. Layout longhands come from [layout_math].
margin margin-inline margin-block
padding padding-inline padding-block
inset inset-inline inset-block
gap grid-gap grid-row-gap grid-column-gap
background background-image background-position background-position-x background-position-y background-size
border border-top border-right border-bottom border-left border-inline border-block border-image
border-width border-top-width border-right-width border-bottom-width border-left-width border-inline-width border-block-width
border-inline-start-width border-inline-end-width border-block-start-width border-block-end-width
border-radius border-top-left-radius border-top-right-radius border-bottom-right-radius border-bottom-left-radius
corner-shape corner-shape-top-left corner-shape-top-right corner-shape-bottom-right corner-shape-bottom-left
box-shadow filter backdrop-filter transform transform-origin object-position
font-size line-height letter-spacing word-spacing text-decoration text-decoration-thickness text-decoration-color text-shadow
mask -webkit-mask mask-border -webkit-mask-box-image -webkit-mask-position -webkit-mask-size

[filter_operations]
BLUR        0
BRIGHTNESS  1
CONTRAST    2
SATURATE    3
HUE_ROTATE  4
INVERT      5
OPACITY     6
SEPIA       7
GRAYSCALE   8
DROP_SHADOW 9

[writes]
# Writer suffix, generated languages, dirty bits, fields in argument order.
# Use text: before the dirty bits for native text-style notifications.
# Use corner: before the dirty bit to refresh the native corner renderer.
# Append @group:mask to stamp TypeScript physical edges before applying the dirty bits.
align                           kotlin           ALIGN                     ALIGN
alignContent                    ts,swift,kotlin  ALIGN_CONTENT             ALIGN_CONTENT
alignItems                      ts,swift,kotlin  ALIGN_ITEMS               ALIGN_ITEMS
alignSelf                       ts,swift,kotlin  ALIGN_SELF                ALIGN_SELF
aspectRatio                     ts,swift,kotlin        ASPECT_RATIO              ASPECT_RATIO
backgroundColor                 ts,swift          text:BACKGROUND_COLOR     BACKGROUND_COLOR BACKGROUND_COLOR_STATE BACKGROUND_COLOR_TYPE
borderBottomStyle               ts,kotlin        BORDER_STYLE              BORDER_BOTTOM_STYLE
borderBottomWidth               ts,kotlin,swift  BORDER                    BORDER_BOTTOM_TYPE BORDER_BOTTOM_VALUE
borderLeftStyle                 ts,kotlin        BORDER_STYLE              BORDER_LEFT_STYLE
borderLeftWidth                 ts,kotlin,swift  BORDER                    BORDER_LEFT_TYPE BORDER_LEFT_VALUE
borderRightStyle                ts,kotlin        BORDER_STYLE              BORDER_RIGHT_STYLE
borderRightWidth                ts,kotlin,swift  BORDER                    BORDER_RIGHT_TYPE BORDER_RIGHT_VALUE
borderTopStyle                  ts,kotlin        BORDER_STYLE              BORDER_TOP_STYLE
borderTopWidth                  ts,kotlin,swift  BORDER                    BORDER_TOP_TYPE BORDER_TOP_VALUE
borderStyles                    ts,kotlin        BORDER_STYLE              BORDER_TOP_STYLE BORDER_RIGHT_STYLE BORDER_BOTTOM_STYLE BORDER_LEFT_STYLE
borderColors                    swift,kotlin     BORDER_COLOR              BORDER_TOP_COLOR BORDER_RIGHT_COLOR BORDER_BOTTOM_COLOR BORDER_LEFT_COLOR
borderWidth                     kotlin,swift     BORDER                    BORDER_TOP_TYPE BORDER_TOP_VALUE BORDER_RIGHT_TYPE BORDER_RIGHT_VALUE BORDER_BOTTOM_TYPE BORDER_BOTTOM_VALUE BORDER_LEFT_TYPE BORDER_LEFT_VALUE
