[keywords]
# CSS property names and their style codes. + denotes a space.
# / introduces a legacy native HTML value. /_ means that HTML ignores the value.
align-items,align-self,justify-items,justify-self normal=-1 start=0 end=1 center=2 baseline=3 stretch=4 flex-start=5/0 flex-end=6/1
align-content,justify-content normal=-1 start=0 end=1 center=2 stretch=3 space-between=4 space-around=5 space-evenly=6 flex-start=7/0 flex-end=8/1
border-style none=0 hidden=1 dotted=2 dashed=3 solid=4 double=5 groove=6 ridge=7 inset=8 outset=9
box-sizing border-box=0 content-box=1
clear none=0 left=1 right=2 both=3
direction inherit=0 ltr=1 rtl=2
# Display adds @base,mode, with an optional TypeScript base or a Kotlin-only value.
display none=0@0,0 flex=1@1,0 grid=2@2,0 block=3@3,0 inline=4@3,1,ts=1 inline-block=5@3,2 inline-flex=6@1,2 inline-grid=7@2,2 list-item=8@3,3,kotlin
flex-direction row=0 column=1 row-reverse=2 column-reverse=3
flex-wrap nowrap=0 no-wrap=0 wrap=1 wrap-reverse=2 balance=3 balance-reverse=4
float none=0 left=1 right=2
font-stretch ultra-condensed=5000 extra-condensed=6250 condensed=7500 semi-condensed=8750 normal=10000 semi-expanded=11250 expanded=12500 extra-expanded=15000 ultra-expanded=20000
font-style normal=0 italic=1 oblique=2
font-variant-numeric normal=0 lining-nums=1 oldstyle-nums=2 proportional-nums=4 tabular-nums=8 diagonal-fractions=16 stacked-fractions=32 ordinal=64 slashed-zero=128
font-weight thin=100 ultralight=200 light=300 normal=400 medium=500 semibold=600 bold=700 heavy=800 black=900
grid-auto-flow row=0 column=1 dense=2 row+dense=2 dense+row=2 column+dense=3 dense+column=3
hyphens manual=0 none=1 auto=2
list-style-position outside=0 inside=1
list-style-type none=0 custom=1/_ disc=2 circle=3 square=4 decimal=5
mask-clip border-box=0 margin-box=0 fill-box=0 stroke-box=0 view-box=0 padding-box=1 content-box=2 no-clip=3
mask-composite add=0 subtract=1 intersect=2 exclude=3
mask-mode match-source=0 alpha=1 luminance=2
object-fit contain=0 cover=1 fill=2 none=3 scale-down=4
overflow,overflow-x,overflow-y visible=0 hidden=1 scroll=2 clip=3 auto=4
position static=0 relative=1 absolute=2 fixed=3 sticky=4
text-align left=1 right=2 center=3 justify=4 start=5 end=6
text-combine-upright none=0 all=1 digits+2=2 digits=2 digits+3=3 digits+4=4
text-justify none=-1 auto=0 inter-word=1 inter-character=2 distribute=3
text-orientation mixed=0 upright=1 sideways=2 sideways-right=2
# The ~2 storage code carries a custom ellipsis token but reads as ellipsis in TypeScript.
text-overflow clip=0 ellipsis=1~2
text-spacing-trim normal=0 space-all=1 space-first=2 trim-start=3 trim-both=4 trim-all=5 auto=6
text-transform none=0 capitalize=1 uppercase=2 lowercase=3
text-wrap wrap=0 nowrap=1 balance=2 pretty=0/3 stable=0/_
touch-action auto=7 none=0 manipulation=7 pan-x=1 pan-left=1 pan-right=1 pan-y=2 pan-up=2 pan-down=2 pinch-zoom=4
unicode-bidi normal=0 embed=1 bidi-override=2 isolate=3 isolate-override=4 plaintext=5
vertical-align baseline=0 top=1 text-top=2 middle=3 bottom=4 text-bottom=5 sub=6 super=7
visibility visible=0 hidden=1 collapse=2
white-space normal=0 pre=1 pre-wrap=2 pre-line=3 nowrap=4 break-spaces=5
writing-mode horizontal-tb=0 vertical-rl=1 vertical-lr=2

[layout_math]
# Type byte for a layout expression. The value word holds its Rust handle.
type=10
# CSS property, fixed writer (or logical type,value,order,slot,dirty bit), optional signed length.
width width
height height
min-width minWidth
min-height minHeight
max-width maxWidth
max-height maxHeight
flex-basis flexBasisType
row-gap rowGap
column-gap columnGap
top insetTopType signed
right insetRightType signed
bottom insetBottomType signed
left insetLeftType signed
margin-top marginTopType signed
margin-right marginRightType signed
margin-bottom marginBottomType signed
margin-left marginLeftType signed
padding-top paddingTopType
padding-right paddingRightType
padding-bottom paddingBottomType
padding-left paddingLeftType
inline-size INLINE_SIZE_TYPE,INLINE_SIZE_VALUE,SIZE_ORDER,6,SIZE
block-size BLOCK_SIZE_TYPE,BLOCK_SIZE_VALUE,SIZE_ORDER,7,SIZE
min-inline-size MIN_INLINE_SIZE_TYPE,MIN_INLINE_SIZE_VALUE,SIZE_ORDER,8,MIN_SIZE
min-block-size MIN_BLOCK_SIZE_TYPE,MIN_BLOCK_SIZE_VALUE,SIZE_ORDER,9,MIN_SIZE
max-inline-size MAX_INLINE_SIZE_TYPE,MAX_INLINE_SIZE_VALUE,SIZE_ORDER,10,MAX_SIZE
max-block-size MAX_BLOCK_SIZE_TYPE,MAX_BLOCK_SIZE_VALUE,SIZE_ORDER,11,MAX_SIZE
inset-block-start INSET_BLOCK_START_TYPE,INSET_BLOCK_START_VALUE,INSET_ORDER,4,INSET signed
inset-inline-end INSET_INLINE_END_TYPE,INSET_INLINE_END_VALUE,INSET_ORDER,5,INSET signed
inset-block-end INSET_BLOCK_END_TYPE,INSET_BLOCK_END_VALUE,INSET_ORDER,6,INSET signed
inset-inline-start INSET_INLINE_START_TYPE,INSET_INLINE_START_VALUE,INSET_ORDER,7,INSET signed
margin-block-start MARGIN_BLOCK_START_TYPE,MARGIN_BLOCK_START_VALUE,MARGIN_ORDER,4,MARGIN signed
margin-inline-end MARGIN_INLINE_END_TYPE,MARGIN_INLINE_END_VALUE,MARGIN_ORDER,5,MARGIN signed
margin-block-end MARGIN_BLOCK_END_TYPE,MARGIN_BLOCK_END_VALUE,MARGIN_ORDER,6,MARGIN signed
margin-inline-start MARGIN_INLINE_START_TYPE,MARGIN_INLINE_START_VALUE,MARGIN_ORDER,7,MARGIN signed
padding-block-start PADDING_BLOCK_START_TYPE,PADDING_BLOCK_START_VALUE,PADDING_ORDER,4,PADDING
padding-inline-end PADDING_INLINE_END_TYPE,PADDING_INLINE_END_VALUE,PADDING_ORDER,5,PADDING
padding-block-end PADDING_BLOCK_END_TYPE,PADDING_BLOCK_END_VALUE,PADDING_ORDER,6,PADDING
padding-inline-start PADDING_INLINE_START_TYPE,PADDING_INLINE_START_VALUE,PADDING_ORDER,7,PADDING

[length_setters]
# Public value/type setter, writer, length kind, and native targets.
# A property target uses its typed setter. Raw uses the writer, and typed also emits the Android Dimension overload.
setInsetLeft            insetLeftType       auto       swift=leftInset kotlin=raw
setInsetRight           insetRightType      auto       swift=rightInset kotlin=raw
setInsetTop             insetTopType        auto       swift=topInset kotlin=raw
setInsetBottom          insetBottomType     auto       swift=bottomInset kotlin=raw
setInsetWithValueType   inset               auto       swift=inset kotlin=raw
setMarginLeft           marginLeftType      auto       swift=marginLeft kotlin=raw
setMarginRight          marginRightType     auto       swift=marginRight kotlin=raw
setMarginTop            marginTopType       auto       swift=marginTop kotlin=raw
setMarginBottom         marginBottomType    auto       swift=marginBottom kotlin=raw
setMarginWithValueType  margin              auto       swift=margin kotlin=raw
setPaddingLeft          paddingLeftType     length     swift=paddingLeft kotlin=raw
setPaddingRight         paddingRightType    length     swift=paddingRight kotlin=raw
setPaddingTop           paddingTopType      length     swift=paddingTop kotlin=raw
setPaddingBottom        paddingBottomType   length     swift=paddingBottom kotlin=raw
setPaddingWithValueType padding             length     swift=padding kotlin=raw
setBorderLeftWidth      borderLeftWidth     length     swift=raw kotlin=borderLeftWidth
setBorderRightWidth     borderRightWidth    length     swift=raw kotlin=borderRightWidth
setBorderTopWidth       borderTopWidth      length     swift=raw kotlin=borderTopWidth
setBorderBottomWidth    borderBottomWidth   length     swift=raw kotlin=borderBottomWidth
setBorderWidth          borderWidth         length     swift=borderWidth kotlin=borderWidth
setFlexBasis            flexBasisType       dimension  swift=flexBasis kotlin=raw
setMinSizeWidth         minWidth            dimension  swift=minSize.width kotlin=typed
setMinSizeHeight        minHeight           dimension  swift=minSize.height kotlin=typed
setMinSizeWidthHeight   minSize             dimension  swift=minSize
setSizeWidth            width               dimension  swift=width kotlin=typed
setSizeHeight           height              dimension  swift=height kotlin=typed
setSizeWidthHeight      size                dimension  swift=size
setMaxSizeWidth         maxWidth            dimension  swift=maxSize.width kotlin=typed
setMaxSizeHeight        maxHeight           dimension  swift=maxSize.height kotlin=typed
setMaxSizeWidthHeight   maxSize             dimension  swift=maxSize
setGapRow               rowGap              length     swift=raw kotlin=raw
setGapColumn            columnGap           length     swift=raw kotlin=raw
setRowGap               rowGap              length     swift=raw
setColumnGap            columnGap           length     swift=raw
