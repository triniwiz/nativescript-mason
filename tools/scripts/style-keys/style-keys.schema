[border_sides]
# Physical edge and the corners at its two ends.
top     TOP_LEFT    TOP_RIGHT
right   TOP_RIGHT   BOTTOM_RIGHT
bottom  BOTTOM_LEFT BOTTOM_RIGHT
left    TOP_LEFT    BOTTOM_LEFT

[accessors]
# Property, writer, language=shape,native type[,flags]. Writers supply fields and dirty bits.
# TypeScript keyword getters read the stored byte. A read-state binding uses its fallback when unset.
