import "Element.idl";
import "TextNode.idl";

namespace NativeScript.Mason
{
    [default_interface]
    runtimeclass Text : Microsoft.UI.Xaml.Controls.Panel, NativeScript.Mason.IMasonElement
    {
        Text();
        Node Node{ get; };
        Style Style{ get; };
        String Content;
        Double FontSize;

        // Lay out and draw text with DirectWrite instead of a TextBlock (on by default); read when a Text
        // is created.
        static Boolean DirectWrite;

        // CSS font-family list; empty resets to the default.
        void SetFontFamily(String families);

        // Inline-run management: runs are TextNode descriptors composed into the TextBlock's Inlines.
        void SetRun(TextNode run, Int32 index);
        void RemoveRun(TextNode run);
        void ClearRuns();

        // A nested text element (span, b, a, ...), rendered inside this one's runs rather than as a
        // child panel. The index counts runs and nested elements together.
        void SetInlineText(Text child, Int32 index);
        void RemoveInlineText(Text child);
    }
}
