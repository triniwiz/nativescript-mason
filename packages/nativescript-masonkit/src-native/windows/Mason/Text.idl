import "Element.idl";
import "TextNode.idl";

namespace NativeScript.Mason
{
    [default_interface]
    runtimeclass Text : Microsoft.UI.Xaml.Controls.Panel, NativeScript.Mason.IMasonElement
    {
        Text();
        // A button: laid out as a button node, focusable, and exposed with the button role.
        static Text CreateButton();
        Boolean IsButton{ get; };
        // Dims a held button; off when it styles :active itself.
        Boolean DimsWhenPressed;
        // A button activated by Enter, Space or UI Automation's Invoke.
        event Microsoft.UI.Xaml.RoutedEventHandler Invoked;
        Node Node{ get; };
        Style Style{ get; };
        String Content;
        Double FontSize;

        // Lay out and draw text with DirectWrite instead of a TextBlock (on by default); read when a Text
        // is created.
        static Boolean DirectWrite;

        // Scale text with the Windows "Text size" setting as XAML text does (on by default).
        static Boolean IsTextScaleFactorEnabled;

        // CSS font-family list; empty resets to the default.
        void SetFontFamily(String families);

        // Inline-run management: runs are TextNode descriptors composed into the TextBlock's Inlines.
        void SetRun(TextNode run, Int32 index);
        void RemoveRun(TextNode run);
        void ClearRuns();

        // A nested text element (span, b, a, ...), rendered inside this one's runs rather than as a
        // child panel. The index counts runs and nested elements together.
        void SetInlineText(Text child, Int32 index);
        void RemoveInlineText(Text child);

        // An inline-level element (inline-block, button, image) placed in this one's text and arranged
        // where the text puts it. The index counts runs, nested elements and boxes together.
        void SetInlineBox(Microsoft.UI.Xaml.UIElement child, Int32 index);
        void RemoveInlineBox(Microsoft.UI.Xaml.UIElement child);

        // Holds a block's inline content (CSS's anonymous block box), so it is never an event target.
        Boolean IsAnonymous;
        // An <a>, exposed to UI Automation as a hyperlink.
        Boolean IsLink;
        Boolean IsListItem;
        void SetTextShadow(String shadows);
        void SetFontFeatureSettings(String value);
    }
}
