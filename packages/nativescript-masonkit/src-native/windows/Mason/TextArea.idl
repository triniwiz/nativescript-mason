import "Element.idl";
import "Event.idl";

namespace NativeScript.Mason
{
  
    [default_interface]
    runtimeclass TextArea : Microsoft.UI.Xaml.Controls.Panel, NativeScript.Mason.IMasonElement
    {
        TextArea();
        Node Node{ get; };
        Style Style{ get; };
        String Value;
        String Placeholder;
        Int32 Rows;
        Int32 Cols;
        Int32 MaxLength;
        void SetFontFamily(String families);

        Int64 AddEventListener(String type, EventListener listener);
        Boolean RemoveEventListener(String type, Int64 id);
    }
}
